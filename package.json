{
  "name": "stratum-workbench",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/typescript-loader.mjs --test tests/signal-engine.test.ts tests/signal-filters.test.ts tests/signal-history.test.ts tests/signal-functions.test.ts tests/regions.test.ts tests/workflow.test.ts tests/time-bases.test.ts tests/high-rate.test.ts tests/mockup-data.test.ts tests/mockup-chart.test.ts tests/plot-ticks.test.ts tests/report-data.test.ts tests/report-templates.test.ts tests/workflow-batch.test.ts tests/parameter-scale.test.ts tests/formats.test.ts tests/formats-mdf.test.ts tests/formats-tdms.test.ts tests/formats-mat.test.ts tests/formats-xlsx.test.ts tests/windowed-evaluation.test.ts",
    "test:preview": "electron tests/preview-worker-smoke.mjs",
    "examples:eol": "node --import ./tests/typescript-loader.mjs examples/eol-rig/generate.ts",
    "desktop:build": "vite build --config desktop/vite.config.ts",
    "desktop": "pnpm desktop:build && electron desktop/main.mjs",
    "desktop:mockup": "pnpm desktop:build && electron desktop/main.mjs --mockup",
    "desktop:report-mockup": "pnpm desktop:build && electron desktop/main.mjs --report-mockup",
    "desktop:report-smoke": "electron tests/report-builder-smoke.mjs",
    "desktop:report-plot-smoke": "electron tests/report-plot-smoke.mjs",
    "desktop:report-workspace-smoke": "electron tests/report-workspace-smoke.mjs",
    "desktop:smoke": "electron desktop/main.mjs --smoke",
    "desktop:ui-smoke": "electron desktop/main.mjs --ui-smoke",
    "desktop:package": "pnpm desktop:build && node desktop/package.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electron/packager": "20.3.0",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "44.2.0",
    "fake-indexeddb": "6.2.5",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0"
}
